<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms both define Application, MessageBox, etc.; usings are explicit instead. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- ThemeMode (Fluent dark theme) is marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AssemblyName>SpeechFlow</AssemblyName>
    <RootNamespace>SpeechFlow</RootNamespace>
    <Version>3.1.1</Version>
    <Product>SpeechFlow</Product>
    <Company>Nashat Shamsadyn</Company>
    <Copyright>Copyright (c) 2026 Nashat Shamsadyn</Copyright>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <!--
    Whisper.net loads its native DLLs from runtimes/<rid>/ next to the exe, so they can't live inside
    the single-file bundle (they would be extracted to a temp folder it never looks in).
    Publish only the x64 ones and keep them beside SpeechFlow.exe.
  -->
  <Target Name="KeepWhisperNativesBesideExe" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(RelativePath)').Replace('\','/').StartsWith('runtimes/')) And !$([System.String]::Copy('%(RelativePath)').Replace('\','/').StartsWith('runtimes/win-x64/'))" />
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(RelativePath)').Replace('\','/').StartsWith('runtimes/win-x64/'))"
          ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
