<Window x:Class="SpeechFlow.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeechFlow update" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ThemeMode="Dark"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Icon="pack://application:,,,/SpeechFlow;component/Assets/icon.ico">
    <Window.Resources>
        <ResourceDictionary><!-- SpeechFlow blue instead of the user's Windows accent colour (defined here so they win over the Fluent theme). -->
        <SolidColorBrush x:Key="AccentButtonBackground" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#7DD3FC" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0EA5E9" />
        <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B1220" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B1220" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0B1220" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#38BDF8" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#7DD3FC" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#0EA5E9" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#7DD3FC" /></ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="24,20">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Text="A new version is available" />
        <TextBlock x:Name="BodyText" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.75" />
        <ProgressBar x:Name="Progress" Height="6" Margin="0,16,0,0" Maximum="1" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="LaterButton" Content="Later" MinWidth="90" Margin="0,0,8,0" IsCancel="True" Click="OnLater" />
            <Button x:Name="UpdateButton" Content="Update now" MinWidth="110" IsDefault="True" Click="OnUpdate" />
        </StackPanel>
    </StackPanel>
</Window>
