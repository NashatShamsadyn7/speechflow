<Window x:Class="SpeechFlow.UI.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeechFlow"
        Width="500" Height="84"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">

    <!-- Margin leaves room for the drop shadow inside the transparent window. -->
    <Border Margin="10" CornerRadius="32" Padding="8,6,10,6"
            Background="{StaticResource BarBackground}" BorderBrush="{StaticResource BarBorder}" BorderThickness="1"
            MouseLeftButtonDown="OnDragStart" ToolTip="Drag to move">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="MicButton" Grid.Column="0" Style="{StaticResource MicButton}" Click="OnMicClick" Content="&#xE720;" />

            <Button x:Name="LanguageButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource LangPill}"
                    Click="OnLanguageClick" Content="AR" ToolTip="Switch language" />

            <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="PreviewText" Foreground="{StaticResource TextPrimary}" FontSize="14"
                           TextTrimming="CharacterEllipsis" Text="SpeechFlow" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Margin="6,0,0,0" Foreground="{StaticResource TextMuted}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <!-- Five-bar level meter. -->
            <StackPanel x:Name="Meter" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Height="24" Margin="0,0,6,0">
                <Rectangle Width="3" Height="3" Margin="1,0" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" Fill="{StaticResource Accent}" />
                <Rectangle Width="3" Height="3" Margin="1,0" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" Fill="{StaticResource Accent}" />
                <Rectangle Width="3" Height="3" Margin="1,0" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" Fill="{StaticResource Accent}" />
                <Rectangle Width="3" Height="3" Margin="1,0" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" Fill="{StaticResource Accent}" />
                <Rectangle Width="3" Height="3" Margin="1,0" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" Fill="{StaticResource Accent}" />
            </StackPanel>

            <Button Grid.Column="4" Style="{StaticResource BarButton}" Click="OnSettingsClick" Content="&#xE713;" ToolTip="Settings" />
            <Button Grid.Column="5" Style="{StaticResource BarButton}" Click="OnHideClick" Content="&#xE921;" ToolTip="Hide (SpeechFlow keeps running in the tray)" />
        </Grid>
    </Border>
</Window>
