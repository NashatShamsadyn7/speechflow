<Window x:Class="SpeechFlow.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeechFlow Settings" Width="560" Height="640" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Icon="/Assets/icon.ico">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="4,3" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#DC2626" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,180,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
                <Button Content="Save" Width="80" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </Grid>

        <TabControl>
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource Label}" Text="Speech engine" Margin="0,0,0,4" />
                        <ComboBox x:Name="EngineBox" SelectionChanged="OnEngineChanged">
                            <ComboBoxItem Tag="groq" Content="Cloud (Groq) — best and fastest, nothing to download" />
                            <ComboBoxItem Tag="local" Content="On this PC — free, private, works offline" />
                        </ComboBox>

                        <StackPanel x:Name="GroqPanel">
                            <TextBlock Style="{StaticResource Label}" Text="Groq API key (free)" />
                            <PasswordBox x:Name="GroqKeyBox" />
                            <TextBlock Style="{StaticResource Hint}">
                                Sign in at
                                <Hyperlink NavigateUri="https://console.groq.com/keys" RequestNavigate="OnLink">console.groq.com/keys</Hyperlink>
                                with Google, click “Create API Key”, and paste it here. No credit card. Stored encrypted for your Windows account.
                            </TextBlock>
                        </StackPanel>

                        <CheckBox x:Name="LivePreviewBox" Margin="0,12,0,0" Click="OnLivePreviewChanged"
                                  Content="Show words live on the bar while I speak" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Uses a small on-device model for the live words (downloaded once). The final text still comes from the engine above." />

                        <StackPanel x:Name="LocalPanel">
                            <TextBlock Style="{StaticResource Label}" Text="On-device model (downloaded once)" />
                            <ComboBox x:Name="ModelBox" SelectionChanged="OnModelChanged" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="DownloadButton" Content="Download" Padding="12,3" Click="OnDownload" />
                                <Button x:Name="DeleteModelButton" Content="Delete" Padding="12,3" Margin="8,0,0,0" Click="OnDeleteModel" />
                                <TextBlock x:Name="ModelStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#6B7280" />
                            </StackPanel>
                            <ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,6,0,0" Maximum="1" Visibility="Collapsed" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Label}" Text="Language" />
                        <ComboBox x:Name="LanguageBox">
                            <ComboBoxItem Tag="ar" Content="العربية — Arabic" />
                            <ComboBoxItem Tag="en" Content="English" />
                            <ComboBoxItem Tag="auto" Content="Detect automatically (Arabic or English per phrase)" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource Label}" Text="Microphone" />
                        <ComboBox x:Name="MicrophoneBox" />

                        <TextBlock Style="{StaticResource Label}" Text="How to insert text" />
                        <ComboBox x:Name="TypingModeBox">
                            <ComboBoxItem Tag="type" Content="Type it (recommended)" />
                            <ComboBoxItem Tag="paste" Content="Paste through the clipboard (for apps that drop typed characters)" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource Label}" Text="Stop automatically after silence (seconds, 0 = never)" />
                        <TextBox x:Name="AutoStopBox" Width="80" HorizontalAlignment="Left" />

                        <CheckBox x:Name="TranslateBox" Content="Translate to English (speak Arabic, get English)" />
                        <CheckBox x:Name="ArabicDigitsBox" Content="Arabic numbers (٣٥ instead of 35)" />
                        <CheckBox x:Name="VoiceCommandsBox" Content="Spoken punctuation (فاصلة، سطر جديد… / comma, new line…)" />
                        <CheckBox x:Name="TashkeelBox" Content="Remove Arabic diacritics (tashkeel)" />
                        <CheckBox x:Name="SoundsBox" Content="Play sounds on start / stop" />
                        <CheckBox x:Name="HistoryBox" Content="Keep a local history of what I dictate" />
                        <CheckBox x:Name="StartupBox" Content="Start SpeechFlow when Windows starts" />
                        <Button Content="Clear dictation history" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,3" Click="OnClearHistory" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="AI polish">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                               Text="AI polish uses the Groq API key from the General tab, even if you dictate with the on-device engine." />

                    <TextBlock Style="{StaticResource Label}" Text="When I press the polish shortcut" />
                    <ComboBox x:Name="PolishModeBox">
                        <ComboBoxItem Tag="grammar" Content="Fix grammar and spelling" />
                        <ComboBoxItem Tag="professional" Content="Make it professional" />
                        <ComboBoxItem Tag="translate" Content="Translate Arabic ⇄ English" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource Hint}" Text="Polish replaces the text you just dictated with the AI version, right where you typed it." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Shortcuts">
                <StackPanel Margin="12">
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                               Text="Write shortcuts like Ctrl+Shift+Space or Ctrl+Alt+D. Each needs at least one of Ctrl, Shift, Alt or Win." />
                    <TextBlock Style="{StaticResource Label}" Text="Start / stop dictation" />
                    <TextBox x:Name="ToggleHotkeyBox" />
                    <TextBlock Style="{StaticResource Label}" Text="Switch Arabic / English" />
                    <TextBox x:Name="LanguageHotkeyBox" />
                    <TextBlock Style="{StaticResource Label}" Text="Undo last phrase" />
                    <TextBox x:Name="UndoHotkeyBox" />
                    <TextBlock Style="{StaticResource Label}" Text="AI polish last dictation" />
                    <TextBox x:Name="PolishHotkeyBox" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Snippets">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Say the phrase on the left and SpeechFlow types the text on the right. Example: “my email” → you@example.com" />
                    <DataGrid x:Name="SnippetGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When I say" Binding="{Binding Trigger}" Width="*" />
                            <DataGridTextColumn Header="Type this" Binding="{Binding Text}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
