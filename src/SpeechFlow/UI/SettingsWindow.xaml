<Window x:Class="SpeechFlow.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeechFlow Settings" Width="580" Height="680" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterScreen" ThemeMode="Dark"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Icon="pack://application:,,,/SpeechFlow;component/Assets/icon.ico">
    <Window.Resources>
        <ResourceDictionary>
        <!-- SpeechFlow blue instead of the user's Windows accent colour (defined here so they win over the Fluent theme). -->
        <SolidColorBrush x:Key="AccentButtonBackground" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#7DD3FC" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0EA5E9" />
        <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B1220" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B1220" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0B1220" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#38BDF8" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#7DD3FC" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#0EA5E9" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#7DD3FC" />
        <SolidColorBrush x:Key="Muted" Color="#9CA3AF" />
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#7DD3FC" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,16,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
            </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#F87171" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,200,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="90" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
                <Button Content="Save" MinWidth="90" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="OnSave" />
            </StackPanel>
        </Grid>

        <TabControl>
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,4,16,12">
                        <TextBlock Style="{StaticResource Label}" Text="Speech engine" />
                        <ComboBox x:Name="EngineBox" SelectionChanged="OnEngineChanged">
                            <ComboBoxItem Tag="groq" Content="Cloud (Groq) — best and fastest" />
                            <ComboBoxItem Tag="local" Content="On this PC — private, works offline" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource Label}" Text="Groq API key" />
                        <PasswordBox x:Name="GroqKeyBox" />
                        <TextBlock Style="{StaticResource Hint}">
                            Free, no credit card:
                            <Hyperlink NavigateUri="https://console.groq.com/keys" RequestNavigate="OnLink">get a key</Hyperlink>.
                            Also used for AI polish. Stored encrypted for your Windows account.
                        </TextBlock>

                        <TextBlock Style="{StaticResource Label}" Text="Language" />
                        <ComboBox x:Name="LanguageBox">
                            <ComboBoxItem Tag="ar" Content="العربية — Arabic" />
                            <ComboBoxItem Tag="en" Content="English" />
                            <ComboBoxItem Tag="auto" Content="Detect automatically (Arabic or English per phrase)" />
                        </ComboBox>
                        <CheckBox x:Name="TranslateBox" Content="Translate to English (speak Arabic, get English)" Margin="0,10,0,0" />

                        <TextBlock Style="{StaticResource Label}" Text="Microphone" />
                        <ComboBox x:Name="MicrophoneBox" />

                        <TextBlock Style="{StaticResource Label}" Text="While dictating" />
                        <CheckBox x:Name="LivePreviewBox" Margin="0,6,0,0" Click="OnLivePreviewChanged" Content="Show my words live on the bar" />
                        <CheckBox x:Name="ArabicDigitsBox" Margin="0,6,0,0" Content="Arabic numbers (٣٥ instead of 35)" />
                        <CheckBox x:Name="SoundsBox" Margin="0,6,0,0" Content="Soft sound on start and stop" />
                        <CheckBox x:Name="StartupBox" Margin="0,6,0,0" Content="Start SpeechFlow when Windows starts" />

                        <!-- Shown when the on-device model is needed (on-device engine or live preview). -->
                        <Border x:Name="LocalPanel" Margin="0,16,0,0" Padding="14" CornerRadius="8" Background="#1F2430">
                            <StackPanel>
                                <TextBlock Text="On-device model" FontWeight="SemiBold" />
                                <ComboBox x:Name="ModelBox" Margin="0,8,0,0" SelectionChanged="OnModelChanged" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="DownloadButton" Content="Download" Click="OnDownload" />
                                    <Button x:Name="DeleteModelButton" Content="Delete" Margin="8,0,0,0" Click="OnDeleteModel" />
                                    <TextBlock x:Name="ModelStatus" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                                <ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,8,0,0" Maximum="1" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Expander Header="Advanced" Margin="0,18,0,0" HorizontalAlignment="Stretch">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Label}" Text="How to insert text" />
                                <ComboBox x:Name="TypingModeBox">
                                    <ComboBoxItem Tag="type" Content="Type it (recommended)" />
                                    <ComboBoxItem Tag="paste" Content="Paste (for apps that drop typed characters)" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource Label}" Text="Stop after this many seconds of silence (0 = never)" />
                                <TextBox x:Name="AutoStopBox" Width="90" HorizontalAlignment="Left" />
                                <CheckBox x:Name="VoiceCommandsBox" Margin="0,14,0,0" Content="Spoken punctuation (فاصلة، سطر جديد… / comma, new line…)" />
                                <CheckBox x:Name="TashkeelBox" Margin="0,6,0,0" Content="Remove Arabic diacritics (tashkeel)" />
                                <CheckBox x:Name="HistoryBox" Margin="0,6,0,0" Content="Keep a local history of what I dictate" />
                                <Button Content="Clear dictation history" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnClearHistory" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Shortcuts">
                <StackPanel Margin="8,4,16,12">
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="A shortcut here stops working in every other app, so only the first one is set by default. Write shortcuts like Ctrl+Shift+Space; leave a box empty for none." />
                    <TextBlock Style="{StaticResource Label}" Text="Start / stop (tap) · push to talk (hold)" />
                    <TextBox x:Name="ToggleHotkeyBox" />
                    <TextBlock Style="{StaticResource Label}" Text="Switch AR → EN → AR→EN" />
                    <TextBox x:Name="LanguageHotkeyBox" />
                    <TextBlock Style="{StaticResource Label}" Text="Undo the last phrase" />
                    <TextBox x:Name="UndoHotkeyBox" />
                    <TextBlock Style="{StaticResource Label}" Text="AI polish the last dictation (uses your Groq key)" />
                    <TextBox x:Name="PolishHotkeyBox" />
                    <ComboBox x:Name="PolishModeBox" Margin="0,8,0,0">
                        <ComboBoxItem Tag="grammar" Content="Fix grammar and spelling" />
                        <ComboBoxItem Tag="professional" Content="Make it professional" />
                        <ComboBoxItem Tag="translate" Content="Translate Arabic ⇄ English" />
                    </ComboBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Snippets">
                <DockPanel Margin="8,4,16,12">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,8,0,10"
                               Text="Say the phrase on the left and SpeechFlow types the text on the right. Example: “my email” → you@example.com" />
                    <DataGrid x:Name="SnippetGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When I say" Binding="{Binding Trigger}" Width="*" />
                            <DataGridTextColumn Header="Type this" Binding="{Binding Text}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="About">
                <StackPanel Margin="8,12,16,12">
                    <TextBlock Text="SpeechFlow" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" />
                    <Button Content="Check for updates" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnCheckUpdates" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="SpeechFlow also checks once a day and tells you when there's a new version." />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,20,0,0">
                        <Hyperlink NavigateUri="https://iosbb0.web.app/#dl-speech" RequestNavigate="OnLink">iosbb0.web.app</Hyperlink>
                        · Made by Nashat Shamsadyn
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
